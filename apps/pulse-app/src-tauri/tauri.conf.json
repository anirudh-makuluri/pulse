{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "0.1.8",
  "identifier": "dev.pulse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulse",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false
      },
      {
        "label": "pet",
        "title": "Pulse pet",
        "width": 68,
        "height": 68,
        "minWidth": 68,
        "minHeight": 68,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/pulse-logo.ico",
      "tooltip": "Pulse"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": ["binaries/pulse-service"],
    "resources": {
      "binaries/pulse-x86_64-pc-windows-msvc.exe": "bin/pulse.exe"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/pulse-logo.ico",
        "uninstallerIcon": "icons/pulse-logo.ico"
      }
    },
    "icon": [
      "icons/pulse-logo-32.png",
      "icons/pulse-logo-128.png",
      "icons/pulse-logo-256.png",
      "icons/pulse-logo-512.png",
      "icons/pulse-logo.ico",
      "icons/pulse-logo.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NEU3ODhEMkQzNDYwRDAKUldUUVlEUXRqWGhPU05pRGthekRteVV2aHBWd3FVZXdGL0gwUjRQYWdvVzNVUlhFb2lVWkZaaFcK",
      "endpoints": [
        "https://github.com/anirudh-makuluri/pulse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
